<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundAdmin">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── TÍTULO ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/an_lisis"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estad_sticas_y_reportes"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvFechaReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/datos_actualizados_abril_2026"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"/>

            <!-- ── TABS PERÍODO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tabSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/semana"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabMes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mes"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_tab_selected"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabAnio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anio"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- ── TARJETAS RESUMEN 3 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="5dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/tendencia" android:gravity="center" android:padding="5dp" />
                    <TextView android:id="@+id/tvMasAbandono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_46" android:textColor="@color/bajoAdmin" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m_s_abandono" android:textColor="@color/texto1Admin" android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="5dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/img2estadisticas" android:gravity="center" android:padding="5dp" />
                    <TextView android:id="@+id/tvDiaMasActivo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vie" android:textColor="@color/medioAdmin" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/d_a_m_s_activo" android:textColor="@color/texto1Admin" android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/completacion" android:gravity="center" android:padding="5dp" />
                    <TextView android:id="@+id/tvPromCompletacion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_73" android:textColor="@color/_2dd4bf_" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/completaci_n" android:textColor="@color/texto1Admin" android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── HÁBITOS CON MAYOR ABANDONO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/tendencia" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/h_bitos_con_mayor_abandono"
                        android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/de_usuarios_que_dejaron_el_h_bito_este_per_odo"
                    android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:id="@+id/llHabitosAbandono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <LinearLayout
                    android:id="@+id/llAlertaHabito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/advertencia" android:gravity="center" android:padding="5dp" />
                    <TextView android:id="@+id/tvAlertaHabito"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/dormir_8h_tiene_la_tasa_m_s_alta_considera_agregar_recordatorios_nocturnos"
                        android:textColor="@color/cc88aa" android:textSize="11sp" android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── ACTIVIDAD POR DÍA ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/calendario" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/actividad_por_d_a"
                        android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/toca_una_barra_para_ver_detalles"
                    android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="8dp"/>

                <!-- ← ID nuevo para el gráfico generado dinámicamente -->
                <LinearLayout
                    android:id="@+id/llActividadChart"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginBottom="8dp"/>

                <!-- Info del día seleccionado -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/d_a_seleccionado" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvDiaSeleccionado"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/s4" android:textColor="@color/a78bfa" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/completaci_n" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvCompletacionDia"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/_88" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/sesiones" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvSesionesDia"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/_1_129" android:textColor="@color/_2dd4bf_" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── PROGRESO PROMEDIO POR USUARIO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/tiroalblancoadmin" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/progreso_por_rango_de_usuarios"
                        android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/distribuci_n_de_1_284_usuarios"
                    android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="12dp"/>

                <!-- Donut + leyenda -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <com.example.consty_group.admin.DonutChartView
                        android:id="@+id/donutProgreso"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout android:id="@+id/llLeyendaProgreso"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"/>
                </LinearLayout>

                <!-- Barras distribución -->
                <LinearLayout android:id="@+id/llDistribucion"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="12dp"/>

                <!-- Resumen 3 métricas -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp"
                        android:background="@drawable/bg_card_dark">
                        <TextView android:id="@+id/tvPromedioGeneral"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/_73" android:textColor="@color/_2dd4bf_" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/promedio" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp"
                        android:background="@drawable/bg_card_dark">
                        <TextView android:id="@+id/tvTop10"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/percent_95" android:textColor="@color/colorMeta" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/top_10" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp"
                        android:background="@drawable/bg_card_dark">
                        <TextView android:id="@+id/tvEnRiesgo"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/count_221" android:textColor="@color/bajoAdmin" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/en_riesgo" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── TENDENCIA MENSUAL ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/tendencia" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/tendencia_mensual"
                        android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/completacion_ultimos_6_meses"
                    android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="8dp"/>

                <!-- ← ID nuevo para gráfico tendencia -->
                <LinearLayout
                    android:id="@+id/llTendenciaChart"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginBottom="8dp"/>

                <!-- Footer leyenda -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="12dp">
                        <View android:layout_width="16dp" android:layout_height="2dp"
                            android:background="@color/colorMeta" android:layout_marginEnd="5dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/completaci_n" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                        <TextView android:id="@+id/tvCambioTendencia"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/tendencia_positiva_demo" android:textColor="@color/envivoTextAdmin" android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/vs_sep" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/tvUsuariosFeb"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/_1_284" android:textColor="@color/_2dd4bf_" android:textSize="11sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/usuarios_activos_label" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ── EXPORTAR ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/exportar_reporte_completo"
                        android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/descarga_datos_reporte"
                    android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnExportarPDF"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_pdf"
                        android:textColor="@color/a78bfa"
                        android:textSize="12sp"
                        android:backgroundTint="@color/bg_export_pdf"
                        android:stateListAnimator="@null"/>
                    <Button
                        android:id="@+id/btnExportarCSV"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/btn_csv"
                        android:textColor="@color/_2dd4bf_"
                        android:textSize="12sp"
                        android:backgroundTint="@color/bg_export_csv"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>