<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgLogoAdmin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_round_purple"
                android:padding="6dp"
                android:src="@drawable/ic_bolt"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HabitAdmin"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnVivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● En vivo"
                android:textColor="#22C55E"
                android:textSize="10sp"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/imgBell"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_notifications"
                android:background="@drawable/bg_round_dark"
                android:padding="5dp"
                android:tint="#AAAACC" />

        </LinearLayout>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANEL DE ADMINISTRADOR"
            android:textColor="#8888AA"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen General"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvFechaAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8888AA"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- TARJETAS ESTADÍSTICAS 2x2 -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="12dp">

            <!-- Usuarios Totales -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_group"
                    android:background="@drawable/bg_icon_blue"
                    android:padding="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvTotalUsuarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.284"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuarios totales"
                    android:textColor="#8888AA"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCambioUsuarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲ +38 este mes"
                    android:textColor="#22C55E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tasa Completación -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_check_circle"
                    android:background="@drawable/bg_icon_green"
                    android:padding="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvTasaCompletacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="73%"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasa completación"
                    android:textColor="#8888AA"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCambioCompletacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲ +5% vs sem. ant."
                    android:textColor="#22C55E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Activos Hoy -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_local_fire"
                    android:background="@drawable/bg_icon_orange"
                    android:padding="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvActivosHoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="347"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activos hoy"
                    android:textColor="#8888AA"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPctActivosHoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27% del total"
                    android:textColor="#FB923C"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Activos esta semana -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_calendar_today"
                    android:background="@drawable/bg_icon_red"
                    android:padding="6dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvActivosSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="892"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activos esta sem."
                    android:textColor="#8888AA"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPctActivosSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="69% del total"
                    android:textColor="#F87171"
                    android:textSize="10sp" />
            </LinearLayout>
        </GridLayout>

        <!-- TARJETA COMPLETACIÓN GENERAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_track_changes"
                    android:tint="#A78BFA"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completación General"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Promedio diario de todos los hábitos activos en la plataforma"
                android:textColor="#8888AA"
                android:textSize="10sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:gap="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meta"
                            android:textColor="#8888AA"
                            android:textSize="10sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="#818CF8"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Actual"
                            android:textColor="#8888AA"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvCompletacionActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="73%"
                            android:textColor="#A78BFA"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Donut chart placeholder -->
                <com.example.consty_group.admin.DonutChartView
                    android:id="@+id/donutChart"
                    android:layout_width="64dp"
                    android:layout_height="64dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- TARJETA USUARIOS ACTIVOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bolt"
                    android:tint="#FACC15"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuarios Activos"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Activos hoy -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Activos hoy" android:textColor="#CCCCCC" android:textSize="11sp" />
                    <TextView android:id="@+id/tvActivosHoyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="347 / 1.284" android:textColor="#F87171" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pbActivosHoy" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progress="27" android:progressTint="#F87171" android:progressBackgroundTint="#1E1E3A" />
            </LinearLayout>

            <!-- Esta semana -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Esta semana" android:textColor="#CCCCCC" android:textSize="11sp" />
                    <TextView android:id="@+id/tvActivosSemanaLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="892 / 1.284" android:textColor="#60A5FA" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pbActivosSemana" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progress="69" android:progressTint="#60A5FA" android:progressBackgroundTint="#1E1E3A" />
            </LinearLayout>

            <!-- Este mes -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="5dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Este mes" android:textColor="#CCCCCC" android:textSize="11sp" />
                    <TextView android:id="@+id/tvActivosMesLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.100 / 1.284" android:textColor="#A78BFA" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar android:id="@+id/pbActivosMes" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progress="85" android:progressTint="#A78BFA" android:progressBackgroundTint="#1E1E3A" />
            </LinearLayout>

        </LinearLayout>

        <!-- HÁBITOS MÁS POPULARES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="#FACC15"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hábitos más Populares"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHabitosPopulares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">
            <!-- Se llena dinámicamente desde el Fragment -->
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:id="@+id/tvUltimaActualizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Última actualización: hace 2 minutos · HabitTracker Admin v1.0"
            android:textColor="#555577"
            android:textSize="9sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
