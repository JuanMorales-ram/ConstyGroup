<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundAdmin">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_purple"
                    android:src="@drawable/destello"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/habitadmin"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/icono10"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usuarios"
                    android:textColor="@color/a78bfa"
                    android:textSize="11sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/tuerca"
                    android:background="@drawable/bg_round_dark"
                    android:padding="5dp"
                     />

            </LinearLayout>

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/administracion"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gestion_usuarios"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvTotalUsuarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usuarios_registrados_plataforma"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- FILTROS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFiltroActivos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activos_6"
                        android:textColor="@color/texto1Admin"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/btnFiltroInactivos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inactivos_2"
                        android:textColor="@color/texto1Admin"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/btnFiltroPro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_3"
                        android:textColor="@color/texto1Admin"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/btnFiltroTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todos"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- BÚSQUEDA -->
            <EditText
                android:id="@+id/etBuscarUsuario"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/buscar_hint"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginBottom="12dp" />

            <!-- ORDENAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ordenar"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btnSortRacha"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/img2estadisticas"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/racha"
                    android:textColor="@color/medioAdmin"
                    android:textSize="11sp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp"/>

                <ImageView
                    android:id="@+id/btnSortProgreso"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/completacion"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progreso"
                    android:textColor="@color/progresoSortColor"
                    android:textSize="11sp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/btnSortNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_sort"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp"

                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <!-- CONTADOR RESULTADOS -->
            <TextView
                android:id="@+id/tvResultados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resultados_8"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <!-- LISTA DE USUARIOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="72dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB NUEVO USUARIO -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/nuevo_usuario"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:backgroundTint="@color/todosUsuarios"
        app:iconTint="@color/white"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
