<?xml version="1.0" encoding="utf-8"?>
<!--
    item_texto_config.xml
    Ubicación: res/layout/item_texto_config.xml
    IDs requeridos por ConfiguracionSistemaFragment:
      · tvTextoLabel  → etiqueta del campo
      · tvTextoSub    → descripción (se oculta si está vacía)
      · etTextoValor  → campo editable
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvTextoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tvTextoSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8888AA"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etTextoValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_search_field"
        android:padding="10dp"
        android:inputType="text"
        android:maxLines="2"/>

</LinearLayout>
