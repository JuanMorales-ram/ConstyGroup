<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundAdmin">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_purple"
                    android:src="@drawable/destello"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/habitadmin"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/campana"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/notificaciones"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/tuerca"
                    android:background="@drawable/bg_round_dark"
                    android:padding="5dp"/>

            </LinearLayout>

            <!-- ── TÍTULO ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comunicaci_n"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notificaciones"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gestiona_y_env_a_comunicados_a_tus_usuarios"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"/>

            <!-- ── TABS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/tabEnviar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp"  android:src="@drawable/enviar" android:gravity="center" android:padding="5dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enviar" android:textColor="@color/white" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMensajes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp"  android:src="@drawable/mensajes1" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mensajes" android:textColor="@color/white" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabProgramar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp"  android:src="@drawable/programar" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/programar" android:textColor="@color/white" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabHistorial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp"  android:src="@drawable/historial" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/historial" android:textColor="@color/white" android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── VISTA PREVIA ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vista_previa_habittracker"
                    android:textColor="@color/texto1Admin"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvPreviewIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_round_purple"
                        android:gravity="center"
                        android:text="🔔"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/t_tulo_de_la_notificaci_n"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvPreviewBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cuerpo_del_mensaje"
                            android:textColor="@color/texto1Admin"
                            android:textSize="11sp"
                            android:maxLines="2"
                            android:ellipsize="end"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ahora"
                            android:textColor="@color/texto1Admin"
                            android:textSize="9sp"
                            android:layout_marginTop="3dp"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── PLANTILLAS RÁPIDAS ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plantillas_r_pidas"
                android:textColor="@color/texto1Admin"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/tmplMotivacion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/amanecer" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motivaci_n_ma_anera" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/buenos_d_as_hoy_es_un_gran_d_a_para" android:textColor="@color/texto1Admin" android:textSize="9sp" android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/tmplRecordatorio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/programar" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recordatorio_h_bito" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_olvides_completar_tu_h_bito_de" android:textColor="@color/texto1Admin" android:textSize="9sp" android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/tmplCelebracion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/img2estadisticas" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/celebraci_n_racha" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/incre_ble_llevas_x_d_as_seguidos" android:textColor="@color/texto1Admin" android:textSize="9sp" android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/tmplFinSemana" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="12dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/fiesta" android:gravity="center" android:padding="5dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fin_de_semana" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="3dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/es_fin_de_semana" android:textColor="@color/texto1Admin" android:textSize="9sp" android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

            </GridLayout>

            <!-- ── EMOJI SELECTOR ── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/emoji" android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="8dp"/>
            <com.example.consty_group.admin.EmojiSelectorView
                android:id="@+id/emojiSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"/>

            <!-- ── TÍTULO NOTIFICACIÓN ── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_tulo_notificaci_n" android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="6dp" android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/etTituloNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="12dp"
                android:inputType="text"
                android:layout_marginBottom="12dp"/>

            <!-- ── MENSAJE ── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mensaje" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                <TextView android:id="@+id/tvCharCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_0_120" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
            </LinearLayout>
            <EditText
                android:id="@+id/etMensajeNotif"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:maxLength="120"
                android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tvCharCountBottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/_0_120_caracteres" android:textColor="@color/texto1Admin" android:textSize="9sp" android:gravity="end" android:layout_marginBottom="12dp"/>

            <!-- ── AUDIENCIA ── -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/audiencia" android:textColor="@color/texto1Admin" android:textSize="11sp" android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/audTodos" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark_selected" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/icono10" android:gravity="center" android:padding="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/todos_los_usuarios" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvCountTodos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_1_284" android:textColor="@color/todosUsuarios" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <ImageView android:id="@+id/radioTodos" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_radio_on"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/audActivos" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/destello" android:gravity="center" android:padding="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usuarios_activos" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_892" android:textColor="@color/_2dd4bf" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <ImageView android:id="@+id/radioActivos" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_radio_off"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/audInactivos" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/inactivos" android:gravity="center" android:padding="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usuarios_inactivos" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_392" android:textColor="@color/f87171" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <ImageView android:id="@+id/radioInactivos" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_radio_off"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/audPro" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/img3estadisticas" android:gravity="center" android:padding="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usuarios_pro" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_347" android:textColor="@color/fb923c" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <ImageView android:id="@+id/radioPro" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_radio_off"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/audRiesgo" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/advertencia" android:gravity="center" android:padding="5dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/en_riesgo_abandono" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_221" android:textColor="@color/bajoAdmin" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                <ImageView android:id="@+id/radioRiesgo" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_radio_off"/>
            </LinearLayout>

            <!-- ── PROGRAMAR ENVÍO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp">

                <ImageView android:layout_width="30dp" android:layout_height="30dp"  android:src="@drawable/programar" android:gravity="center" android:padding="5dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/programar_env_o" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enviar_en_una_hora_espec_fica" android:textColor="@color/texto1Admin" android:textSize="11sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchProgramar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/_2a2a4a"/>

            </LinearLayout>

            <!-- ── BOTÓN ENVIAR ── -->
            <Button
                android:id="@+id/btnEnviarNotif"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/enviar_ahora_1_284_usuarios"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>