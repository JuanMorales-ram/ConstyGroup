<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgrpundimg"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".auth.Registro">

    <ScrollView
        android:id="@+id/ScrollLogIn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerLogIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- TEXTO SUPERIOR -->
            <TextView
                android:id="@+id/TextBienvenidaLogIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="16dp"
                android:text="@string/FraceMotivacional4"
                android:textColor="@color/TextoGris"
                android:textSize="16sp" />

            <!-- LOGO -->
            <ImageView
                android:id="@+id/LogoLogIn"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp"
                app:srcCompat="@drawable/logosinfondo"
                android:contentDescription="Logo"/>

            <!-- NOMBRE EMPRESA -->
            <TextView
                android:id="@+id/NombreEmpresaLogIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/NombteEmpresa"
                android:textColor="@color/white"
                android:textSize="50sp"
                android:fontFamily="@font/tan" />

            <!-- EMAIL -->
            <EditText
                android:id="@+id/InputEmailLogIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/style_edit_text"
                android:hint="@string/TextEmail"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:textColor="@color/black" />

            <!-- CONTRASEÑA -->
            <EditText
                android:id="@+id/InputContrasenaLogIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/style_edit_text"
                android:hint="@string/TextContrasena"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/TextRecupContra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="80dp"
                android:text="Olvidaste tu contraseña?"
                android:textColor="@color/backgroundColo"
                android:textSize="15sp"
                android:textStyle="bold"
                />

            <!-- BOTÓN LOGIN -->
            <Button
                android:id="@+id/ButtonLogIn"
                android:layout_width="250dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/backgroundColo"
                android:text="@string/TextBotonRegistro"
                android:textColor="@color/white"
                android:textAllCaps="false" />



            <!-- TEXTO CONTINUAR -->
            <TextView
                android:id="@+id/TextContinuarLogIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/continua_conText"
                android:textColor="@color/backgroundColo"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- REDES -->
            <LinearLayout
                android:id="@+id/ContainerRedesLogIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- GOOGLE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonGoogleLogIn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="8dp"
                    android:text=""
                    android:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/googlelogo"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@null" />

                <!-- FACEBOOK -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ButtonFacebookLogIn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="8dp"
                    android:text=""
                    android:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/facebooklogo"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@null" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>